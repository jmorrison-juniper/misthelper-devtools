# SpaceX Enterprise API reference (upstream clone, not MistHelper code)
starlink-api-reference/

# Archived spec folders (local reference only, not for GitHub commits)
finished-specs/
abandoned-specs/

# Auto-generated audit-menu SpecKit stubs (stale, replaced by numbered specs)
specs/*-audit-menu-*/


# Throwaway evidence snapshots from spec decomposition runs (CodeQL false positives)
specs/**/evidence/.tmp_*

# uv lockfile — project uses pip via hatchling, not uv
uv.lock

# SpecKit Companion extension (local dev tool, re-installable)
# The payload holds 15 third-party Python scripts. The repo-wide gates
# (black, bandit, CodeQL) do not exclude .specify, so the payload stays untracked.
# To install, run: specify extension add companion --from <release-url>
# The .github patterns are scoped, because both folders hold tracked spec-kit files.
.specify/extensions/companion/
.github/agents/speckit.companion.*
.github/prompts/speckit.companion.*


# Claude Code agent scratch. A worktree here was committed as a broken gitlink once (issue #1752).
.claude/
.github/skills/juniper-junos-fundamentals/
